{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyguard:schema:status-update-request:1.0.0",
  "title": "StatusUpdateRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Версія контракту пакета."
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "description": "Ключ повторного надсилання; не є ID особи й не надає прав."
    },
    "shelter_id": {
      "type": "string",
      "pattern": "^SH-[A-Z0-9]{2,16}-[0-9]{3,8}$",
      "maxLength": 28,
      "description": "ID укриття; має збігатися з ID у маршруті API."
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED",
        "OVERCROWDED",
        "MAINTENANCE"
      ],
      "description": "Спостережуваний статус; стає публічним після серверного підтвердження."
    },
    "user_latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Широта пристрою репортера."
    },
    "user_longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Довгота пристрою репортера."
    },
    "location_accuracy_m": {
      "type": "number",
      "minimum": 0,
      "description": "Заявлена пристроєм точність координат; не є відстанню до укриття."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "description": "Час отримання координат або спостереження; актуальність перевіряє сервер."
    },
    "consent_id": {
      "type": "string",
      "format": "uuid",
      "description": "Посилання на згоду. Наявність ID у пакеті не доводить чинність згоди."
    },
    "current_occupancy": {
      "type": "integer",
      "minimum": 0,
      "description": "Фактичне спостереження заповнення. Перевищення місткості не приховується."
    },
    "comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S",
      "description": "Приватний коментар репортера; автоматично не публікується."
    }
  },
  "required": [
    "schema_version",
    "requestId",
    "shelter_id",
    "status",
    "user_latitude",
    "user_longitude",
    "location_accuracy_m",
    "observed_at",
    "consent_id"
  ]
}
